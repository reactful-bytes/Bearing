{
  "name": "bearing-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run build && node --test lib/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@firebase/app": "^0.16.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4"
  }
}

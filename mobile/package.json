{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.11",
    "@react-navigation/native": "^7.3.11",
    "expo": "~57.0.16",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.9",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-file-system": "~57.0.4",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-purchases": "^10.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.25.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "android:build:dev": "eas build --platform android --profile development",
    "android:build:dev:local": "set -a; . ./.env; set +a; EXPO_PUBLIC_APP_ENV=development eas build --platform android --profile development --local",
    "android:build:preview": "eas build --platform android --profile preview",
    "android:build:preview:local": "set -a; . ./.env; set +a; EXPO_PUBLIC_APP_ENV=preview eas build --platform android --profile preview --local",
    "android:build:prod": "eas build --platform android --profile production",
    "android:build:prod:local": "set -a; . ./.env; set +a; EXPO_PUBLIC_APP_ENV=production eas build --platform android --profile production --local",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project bearing-rules-test --only firestore \"jest --config jest.rules.config.js --runInBand\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "private": true
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsExistingDocument() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    match /users/{userId} {
      allow read, delete: if isCurrentUser(userId);
      allow create: if isCurrentUser(userId)
        && request.resource.data.premiumStatus == 'free'
        && request.resource.data.premiumSource == 'none';
      allow update: if isCurrentUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'email',
          'timezone',
          'locale',
          'tipsEnabled',
          'reminderSoundId',
          'alarmSoundId',
          'updatedAt'
        ]);
    }

    match /events/{eventId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }

    match /notes/{noteId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }

    match /goals/{goalId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }

    match /goalSteps/{stepId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }

    match /tasks/{taskId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }

    match /subscriptions/{userId} {
      allow read: if isCurrentUser(userId);

      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}